{
    "dest": "projects/components/src/assets",
    "svg": {
        "transform": [
            {
                "svgo": {
                    "plugins": [
                        {
                            "name": "preset-default",
                            "params": {
                                "overrides": {
                                    "convertShapeToPath": false,
                                    "moveGroupAttrsToElems": false
                                }
                            }
                        }
                    ]
                }
            }
        ]
    },
    "mode": {
        "symbol": {
            "inline": true,
            "sprite": "icondefinitions.svg",
            "dest": ".",
            "example": true
        },
        "svg": {
            "xmlDeclaration": false,  
            "doctypeDeclaration": false, 
            "xmlns": false
        }
    }
}
